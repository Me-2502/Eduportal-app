APP_ENV=dev

# App connection: login role that is a member of eduportal_app (RLS applies)
DATABASE_URL=postgresql+psycopg://eduportal_api:CHANGE_ME@localhost:5432/eduportal
# Owner connection: only used by scripts (migrate / seed), bypasses RLS
DATABASE_OWNER_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/eduportal

# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=28800

OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# JSON list
CORS_ORIGINS=["http://localhost:5173"]
